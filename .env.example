APP_NAME="BaleBolen"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

# Paksa HTTPS (aktifkan hanya setelah sertifikat terpasang).
FORCE_HTTPS=false

# Idle timeout dashboard admin dalam menit (0 = nonaktif).
ADMIN_IDLE_MINUTES=30

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=balebolen
DB_USERNAME=root
DB_PASSWORD=

# Batas ukuran upload gambar produk (byte). Default 3 MB.
UPLOAD_MAX_BYTES=3145728

# Batas jumlah per baris keranjang dan pembuatan pesanan per 10 menit per IP.
MAX_ITEM_QTY=50
CHECKOUT_PER_10MIN=5
