Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Paksa HTTPS di domain publik (localhost tetap HTTP untuk pengembangan).
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Blokir eksekusi PHP di folder upload
    RewriteRule ^uploads/.*\.(php|phtml|phar)$ - [F,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # Aktifkan HSTS hanya setelah HTTPS terbukti stabil di domain produksi:
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
